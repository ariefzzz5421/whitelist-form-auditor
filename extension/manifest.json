{
  "manifest_version": 3,
  "name": "Whitelist / Waitlist Submission Detector",
  "version": "1.0.0",
  "description": "YES/NO detector for dummy whitelist or waitlist form submissions.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "sidePanel", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Submission Detector"
  }
}
